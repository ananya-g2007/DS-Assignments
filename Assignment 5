#include <iostream>
using namespace std;


class Shape {
public:
    
    virtual void draw() {
        cout << "Drawing a generic shape" << endl;
    }

   
    virtual ~Shape() {}
};


class Circle : public Shape {
public:
    void draw() override {
        cout << "Drawing a Circle" << endl;
    }
};


class Rectangle : public Shape {
public:
    void draw() override {
        cout << "Drawing a Rectangle" << endl;
    }
};

int main() {

    Shape* shape;

  
    Circle c;
    shape = &c;
    shape->draw();   // Calls Circle's draw()

    Rectangle r;
    shape = &r;
    shape->draw();   // Calls Rectangle's draw()

    Shape* shapes[2];
    shapes[0] = new Circle();
    shapes[1] = new Rectangle();

    cout << "\nPolymorphism with array of shapes:" << endl;
    for(int i=0; i<2; i++) {
        shapes[i]->draw();  // Calls appropriate draw() at runtime
    }


    delete shapes[0];
    delete shapes[1];

    return 0;
}
