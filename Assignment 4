#include <iostream>
using namespace std;


class Point {
    int x, y;
public:
    // Constructor
    Point(int a=0, int b=0) : x(a), y(b) {}

 
    void display() {
        cout << "(" << x << ", " << y << ")" << endl;
    }

    int getX() { return x; }
    int getY() { return y; }
};


int add(int a, int b) { return a + b; }
int sub(int a, int b) { return a - b; }
int mul(int a, int b) { return a * b; }


Point add(Point p1, Point p2) {
    return Point(p1.getX() + p2.getX(), p1.getY() + p2.getY());
}
Point sub(Point p1, Point p2) {
    return Point(p1.getX() - p2.getX(), p1.getY() - p2.getY());
}
Point mul(Point p1, Point p2) {
    return Point(p1.getX() * p2.getX(), p1.getY() * p2.getY());
}

int main() {
 
    cout << "Add int: " << add(3, 5) << endl;
    cout << "Sub int: " << sub(10, 4) << endl;
    cout << "Mul int: " << mul(2, 6) << endl;

    Point p1(2, 3), p2(4, 5);
    Point p3 = add(p1, p2);
    Point p4 = sub(p1, p2);
    Point p5 = mul(p1, p2);

    cout << "Add Point: "; p3.display();
    cout << "Sub Point: "; p4.display();
    cout << "Mul Point: "; p5.display();

    return 0;
}
